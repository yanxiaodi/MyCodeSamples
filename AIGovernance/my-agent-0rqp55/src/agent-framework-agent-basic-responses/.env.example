FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# Set to false to compare the same agent without ACS middleware or tool approval.
ENABLE_GOVERNANCE=true

# Azure Communication Services email configuration.
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=<connection-string>
AZURE_COMMUNICATION_SERVICES_SENDER=<verified-sender-address>
DEMO_EMAIL_RECIPIENT=<demo-recipient-address>

# Optional Azure Monitor / Application Insights telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>
