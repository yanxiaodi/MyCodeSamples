# Copy this file to .env and fill in the values you want to use.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=

# Optional future real-email sender; the current demo uses a fake sender.
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_COMMUNICATION_SERVICES_SENDER=
DEMO_EMAIL_RECIPIENT=demo-recipient@example.net
